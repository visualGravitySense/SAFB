VITE_API_URL=http://localhost:3000/api
VITE_TELEGRAM_ADMIN_CHAT_ID=5883625804
# Ссылка на бота (https://t.me/YourBotName) — если пусто, кнопка прокручивает к форме бронирования
VITE_TELEGRAM_BOT_LINK=
# Для локальной разработки: URL развёрнутого сайта (напр. https://safunkband.vercel.app) — тогда /api проксируется туда
# VITE_TELEGRAM_API_URL=https://your-site.vercel.app

# Имитация Telegram — true = вывод в терминал (локальный тест), false = отправка в Telegram (publish)
VITE_TELEGRAM_DEBUG=false